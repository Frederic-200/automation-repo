  "facts": [
   {
    "claim": "A context window is the text a model can consider at once, its working memory, including the conversation and the model's own replies",
    "sources": [
     0,
     1
    ]
   },
   {
    "claim": "In a long chat earlier turns count toward the window; when the limit is exceeded the content must be truncated or summarized",
    "sources": [
     0,
     1
    ]
   },
   {
    "claim": "Models perform best when relevant information is at the start or end of a long input and worse when it is in the middle (Lost in the Middle, 2023)",
    "sources": [
     2,
     1
    ]
   },
