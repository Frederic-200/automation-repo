  "facts": [
   {
    "claim": "In the US an AI system is not a legal person; one legal explainer says no legal system worldwide grants AI that status",
    "sources": [
     0,
     4
    ]
   },
   {
    "claim": "When AI causes harm, people generally sue the company behind it, not the AI",
    "sources": [
     0,
     1
    ]
   },
   {
    "claim": "A traveler got wrong information about a bereavement fare from Air Canada's chatbot and the airline refused the refund",
    "sources": [
     2,
     3
    ]
   },
   {
    "claim": "Air Canada argued the chatbot was a separate legal entity responsible for its own actions",
    "sources": [
     2,
     3
    ]
   },
   {
    "claim": "A British Columbia tribunal rejected that and held the chatbot is part of the airline's website, so the airline was responsible",
    "sources": [
     2,
     3
    ]
   },
   {
    "claim": "The passenger was awarded about 650 Canadian dollars in damages",
    "sources": [
     2,
     3
    ]
   },
   {
    "claim": "Courts and experts are still working out how liability for AI works",
    "sources": [
     0,
     1
    ]
   }
  ],
  "post": {
